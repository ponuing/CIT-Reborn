{
  "schemaVersion": 1,
  "id": "citreborn",
  "version": "${version}",
  "name": "Cit Reborn",
  "description": "Mod for return support CIT Optifine Resource pack's. Based on CIT Resewn",
  "authors": [
    "ponuing"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/cit-reborn-mod",
    "sources": "https://github.com/ponuing/CIT-Reborn",
    "issues": "https://github.com/ponuing/CIT-Reborn/issues"
  },
  "license": "MIT",
  "icon": "assets/citreborn/logo.png",
  "environment": "client",
  "accessWidener": "citreborn.accesswidener",
  "entrypoints": {
    "client": [
      "com.ponuing.CITReborn"
    ],
    "modmenu": [
      "com.ponuing.config.CITRebornModMenu"
    ],
    "citresewn:condition": [
      "com.ponuing.cit.builtin.conditions.core.FallbackCondition::CONTAINER",
      "com.ponuing.cit.builtin.conditions.core.WeightCondition::CONTAINER"
    ],
    "citresewn:global_property": [
      "com.ponuing.cit.builtin.conditions.core.FallbackCondition::globalProperty"
    ]
  },
  "mixins": [
    "citreborn.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
